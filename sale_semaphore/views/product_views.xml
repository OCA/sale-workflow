<odoo>
    <record id="product_template_form_view" model="ir.ui.view">
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath
                expr="//page[@name='sales']//group[@name='description']"
                position="after"
            >
                <group
                    string="Semaphore"
                    name="semaphore_discounts"
                    attrs="{'invisible': [('product_variant_count', '&gt;', 1), ('is_product_variant', '=', False)]}"
                >
                    <field name="semaphore_active" string="Active" />
                    <field
                        name="semaphore_discount_success"
                        attrs="{'invisible': [('semaphore_active', '=', 'no')]}"
                    />
                    <field
                        name="semaphore_discount_warning"
                        attrs="{'invisible': [('semaphore_active', '=', 'no')]}"
                    />
                    <field
                        name="semaphore_discount_danger"
                        attrs="{'invisible': [('semaphore_active', '=', 'no')]}"
                    />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
