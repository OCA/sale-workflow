<odoo>
    <record id="product_category_form_view" model="ir.ui.view">
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='first']" position="after">
                <group>
                    <group string="Semaphore" name="semaphore_discounts">
                        <field name="semaphore_active" string="Active" />
                        <field
                            name="semaphore_discount_success"
                            invisible="not semaphore_active"
                        />
                        <field
                            name="semaphore_discount_warning"
                            invisible="not semaphore_active"
                        />
                        <field
                            name="semaphore_discount_danger"
                            invisible="not semaphore_active"
                        />
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
