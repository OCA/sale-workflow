<odoo>

    <record model="ir.ui.view" id="res_config_setting_form_view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@id='proforma_configuration']" position="after">
                <div
                    class="col-12 col-lg-6 o_setting_box"
                    id="compute_so_payment_terms_from_partner_invoice"
                >
                    <div class="o_setting_left_pane">
                        <field name="compute_so_payment_terms_from_partner_invoice" />
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="compute_so_payment_terms_from_partner_invoice" />
                        <div class="text-muted">
                            Compute 'payment terms' on sale orders
                            based on the payment terms of the invoice partner ('invoice address')
                            instead of the base partner of the sale order ('customer')
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
