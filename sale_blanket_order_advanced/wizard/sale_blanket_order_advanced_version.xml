<odoo>
    <record id="view_sale_blanket_order_advanced_version_form" model="ir.ui.view">
        <field name="name">sale.blanket.order.advanced.version.form</field>
        <field name="model">sale.blanket.order.advanced.version.wizard</field>
        <field name="arch" type="xml">
            <form string="Create New Version">
                <sheet>
                    <group>
                        <field name="old_blanket_order_id" invisible="1" />
                        <field name="new_blanket_order_id" invisible="1" />
                        <field name="price_adjustment_percent" />
                    </group>
                    <footer>
                        <button
                            string="Create Version"
                            type="object"
                            name="create_version"
                            class="btn-primary"
                        />
                        <button
                            string="Cancel"
                            class="btn-secondary"
                            special="cancel"
                        />
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_create_advanced_version_wizard" model="ir.actions.act_window">
        <field name="name">Create Advanced Version</field>
        <field name="res_model">sale.blanket.order.advanced.version.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_old_blanket_order_id': active_id}</field>
    </record>
</odoo>
