<odoo>
    <record id="view_blanket_order_product_tree" model="ir.ui.view">
        <field name="name">blanket.order.product.tree</field>
        <field name="model">blanket.order.product</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="product_id" />
                <field name="quantity" />
                <field name="price_unit" />
                <field name="amount_total" />
            </tree>
        </field>
    </record>

    <record id="action_blanket_order_product" model="ir.actions.act_window">
        <field name="name">Product Costs</field>
        <field name="res_model">blanket.order.product</field>
        <field name="view_mode">tree</field>
    </record>
</odoo>
