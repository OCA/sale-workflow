<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name"
        >res.config.settings.view.form.inherit.sale.partner.sale.contact</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//div[@name='quotation_order_setting_container']"
                position="inside"
            >
                <div class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane">
                        <field name="sale_display_contact_on_reports" />
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="sale_display_contact_on_reports" />
                        <div class="text-muted">
                            Display the sale contact on sale orders and invoices PDF reports
                        </div>
                    </div>
                </div>

            </xpath>
        </field>
    </record>
</odoo>
