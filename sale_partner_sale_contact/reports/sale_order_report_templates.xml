<odoo>
    <template
        id="report_saleorder_document"
        inherit_id="sale.report_saleorder_document"
    >
        <!-- Add sale contact in the address block after partner name and address -->
        <xpath expr="//t[@t-set='address']" position="inside">
            <p
                t-if="doc.sale_contact_partner_id and doc.company_id.sale_display_contact_on_reports"
                class="mt-2"
            >
                <strong>Sale Contact:</strong>
                <span t-field="doc.sale_contact_partner_id.name" />
            </p>
        </xpath>
    </template>
</odoo>
