<odoo>
    <!-- Group rules are OR-ed: these rules extend the standard portal
         visibility (based on partner_id) with read-only access to the
         documents on which the portal user is the named sale contact. -->
    <record id="sale_order_rule_portal_sale_contact" model="ir.rule">
        <field name="name">Portal Sale Orders as Sale Contact</field>
        <field name="model_id" ref="sale.model_sale_order" />
        <field
            name="domain_force"
        >[('sale_contact_partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>

    <record id="sale_order_line_rule_portal_sale_contact" model="ir.rule">
        <field name="name">Portal Sale Order Lines as Sale Contact</field>
        <field name="model_id" ref="sale.model_sale_order_line" />
        <field
            name="domain_force"
        >[('order_id.sale_contact_partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>
</odoo>
