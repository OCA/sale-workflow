#. module: sale_order_line_final_price
#: model:ir.model.fields,field_description:sale_order_line_final_price.field_sale_order_line__price_final
msgid "Final Price"
msgstr "Precio final"

#. module: sale_order_line_final_price
#: model:ir.model.fields,field_description:sale_order_line_final_price.field_sale_order_line__price_edit_allowed
msgid "Price Edit Allowed"
msgstr "Edición de precio permitida"

#. module: sale_order_line_final_price
#: model:ir.model,name:sale_order_line_final_price.model_sale_order_line
msgid "Sales Order Line"
msgstr "Línea de pedido de venta"

#. module: sale_order_line_final_price
#: model:ir.model.fields,help:sale_order_line_final_price.field_sale_order_line__price_edit_allowed
msgid ""
"Technical field to know whether the current user is allowed to edit the unit"
" price and the discount of the line."
msgstr ""
"Campo técnico para saber si el usuario actual puede editar el precio unitario"
" y el descuento de la línea."

#. module: sale_order_line_final_price
#: model:ir.model.fields,help:sale_order_line_final_price.field_sale_order_line__price_final
msgid ""
"Unit price once the discount is applied. Set here the price agreed with the "
"customer and the discount will be computed accordingly, keeping the unit "
"price given by the pricelist."
msgstr ""
"Precio unitario una vez aplicado el descuento. Indique aquí el precio "
"acordado con el cliente y el descuento se calculará en consecuencia, "
"manteniendo el precio unitario que da la tarifa."