#. module: sale_pricelist_fixed_price_no_discount
#. odoo-python
#: code:addons/sale_pricelist_fixed_price_no_discount/models/sale_order_line.py:0
msgid ""
"Discounts are not allowed when the applied pricelist rule uses a fixed "
"price."
msgstr ""
"Les remises ne sont pas autorisées lorsque la règle de liste de prix "
"appliquée utilise un prix fixe."

#. module: sale_pricelist_fixed_price_no_discount
#: model:ir.model.fields,field_description:sale_pricelist_fixed_price_no_discount.field_sale_order_line__fixed_price_pricelist_rule
msgid "Fixed Price Pricelist Rule"
msgstr "Règle de liste de prix à prix fixe"

#. module: sale_pricelist_fixed_price_no_discount
#: model:ir.model.fields,field_description:sale_pricelist_fixed_price_no_discount.field_product_pricelist_item__fixed_price_no_discount
msgid "Prevent Discounts on Fixed Price"
msgstr "Empêcher les remises sur les prix fixes"

#. module: sale_pricelist_fixed_price_no_discount
#: model:ir.model.fields,help:sale_pricelist_fixed_price_no_discount.field_product_pricelist_item__fixed_price_no_discount
msgid ""
"Prevent manual discounts on sale order lines when this fixed-price rule is "
"applied."
msgstr ""
"Empêche les remises manuelles sur les lignes de commande client lorsque cette "
"règle à prix fixe est appliquée."

#. module: sale_pricelist_fixed_price_no_discount
#: model:ir.model,name:sale_pricelist_fixed_price_no_discount.model_sale_order_line
msgid "Sales Order Line"
msgstr "Ligne de commande client"
