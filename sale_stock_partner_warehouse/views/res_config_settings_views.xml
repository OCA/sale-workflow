<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='order_warnings']" position="after">
                <setting
                    id="sale_warehouse_by_partner_shipping"
                    string="Prioritize Shipping Partner in Sale Warehouse Proposal"
                    help="If enabled, the sale order will propose the warehouse from the shipping address, falling back to the customer's warehouse if none is set."
                >
                    <field name="sale_warehouse_by_partner_shipping" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
