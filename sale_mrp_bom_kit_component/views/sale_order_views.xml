<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_sale_order_line_kit_component_form" model="ir.ui.view">
        <field name="name">sale.order.line.kit.component.form</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <form string="Kit Components">
                <field name="state" invisible="1" />
                <field name="is_kit" invisible="1" />
                <header>
                    <button
                        name="action_reload_kit_components"
                        type="object"
                        string="Reset to Default BoM"
                        class="btn-secondary"
                        invisible="state in ['sale', 'cancel']"
                    />
                </header>
                <sheet>
                    <field
                        name="kit_component_ids"
                        nolabel="1"
                        readonly="state in ['sale', 'cancel']"
                    >
                        <list editable="bottom">
                            <field name="sequence" widget="handle" />
                            <field name="is_selected" widget="boolean_toggle" />
                            <field
                                name="product_id"
                                readonly="bom_line_id"
                                force_save="1"
                            />
                            <field name="product_qty" />
                            <field name="product_uom_id" readonly="1" force_save="1" />
                            <field
                                name="bom_line_id"
                                column_invisible="True"
                                force_save="1"
                            />
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button string="Close" class="btn-primary" special="save" />
                </footer>
            </form>
        </field>
    </record>

    <record id="view_order_form_inherit_kit_component" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.kit.component</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='order_line']//list//field[@name='name']"
                position="after"
            >
                <field name="is_kit" column_invisible="True" />
                <button
                    name="action_open_kit_components"
                    type="object"
                    string="Components"
                    icon="fa-list"
                    title="Configure Kit Components"
                    invisible="not is_kit"
                />
            </xpath>
            <xpath expr="//field[@name='order_line']//form" position="inside">
                <group string="Kit Components" invisible="not is_kit">
                    <button
                        name="action_reload_kit_components"
                        type="object"
                        string="Reset to Default BoM"
                        class="btn-secondary mb-2"
                        invisible="state in ['sale', 'cancel']"
                    />
                    <field
                        name="kit_component_ids"
                        nolabel="1"
                        readonly="state in ['sale', 'cancel']"
                    >
                        <list editable="bottom">
                            <field name="sequence" widget="handle" />
                            <field name="is_selected" widget="boolean_toggle" />
                            <field
                                name="product_id"
                                readonly="bom_line_id"
                                force_save="1"
                            />
                            <field name="product_qty" />
                            <field name="product_uom_id" readonly="1" force_save="1" />
                            <field
                                name="bom_line_id"
                                column_invisible="True"
                                force_save="1"
                            />
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
