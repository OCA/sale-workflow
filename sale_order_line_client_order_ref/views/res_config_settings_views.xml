<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_sale_config_settings" model="ir.ui.view">
        <field name="name">res.config.settings</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='proforma_configuration']" position="after">
                <setting
                    id="show_client_order_ref_sale"
                    company_dependent="1"
                    string="Show Customer Order Reference in Sale Reports (PDF)"
                    help="If selected, the Order Ref column will be added to the lines in the sale report (PDF)"
                >
                    <field name="show_client_order_ref_sale" />
                </setting>
                <setting
                    id="client_order_ref_in_invoice_line_desc"
                    company_dependent="1"
                    string="Include Customer Order Reference in Invoice Line Description"
                    help="When enabled, the invoice line description will begin with the customer order reference, followed by a new line and the original description."
                >
                    <field name="client_order_ref_in_invoice_line_desc" />
                </setting>
                <setting
                    id="so_line_client_ref_policy"
                    company_dependent="1"
                    string="Sales Order Line Customer Order Ref Sync(chronization) Policy"
                    help="Select the policy to sync the customer order reference from the sales order to its lines."
                >
                    <field name="so_line_client_ref_policy" widget="radio" />
                </setting>
            </xpath>
        </field>
    </record>
    <record id="view_invoice_config_settings" model="ir.ui.view">
        <field name="name">res.config.settings</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='show_sale_receipts']" position="after">
                <setting
                    id="show_client_order_ref_invoice"
                    company_dependent="1"
                    string="Show Customer Order Reference in Invoice Reports (PDF)"
                    help="If selected, the Order Ref column will be added to the lines in the invoice report (PDF)"
                >
                    <field name="show_client_order_ref_invoice" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
