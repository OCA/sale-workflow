<?xml version="1.0" encoding="utf-8" ?>
<odoo>
<record id="matrix_wizard_form" model="ir.ui.view">
    <field name="model">wizard.price.config.matrix</field>
    <field name="name">wizard.price.config.matrix.form</field>
    <field name="arch" type="xml">
        <form>
            <sheet>
                <h2>Price matrix</h2>
                <group>
                    <field name="target_field_domain" invisible="1" />
                    <field name="should_show_matrix_input" invisible="1" />
                    <group>
                        <field name="vertical_value" domain="target_field_domain" />
                        <button
                                name="show_matrix_input"
                                type="object"
                                string="Afficher champ matrice"
                                attrs="{'invisible': [('should_show_matrix_input', '=', True)]}"
                                colspan="2"
                            />
                        <button
                                name="hide_matrix_input"
                                type="object"
                                string="Afficher tableau matrice"
                                attrs="{'invisible': [('should_show_matrix_input', '=', False)]}"
                                colspan="2"
                            />
                    </group>
                    <group>
                        <field name="horizontal_value" domain="target_field_domain" />
                    </group>
                    <field
                            name="matrix"
                            widget="matrix_table"
                            attrs="{'invisible': [('should_show_matrix_input', '=', True)]}"
                        />
                    <field
                            name="matrix"
                            attrs="{'invisible': [('should_show_matrix_input', '=', False)]}"
                        />
                </group>
            </sheet>
        </form>
    </field>
</record>
</odoo>
