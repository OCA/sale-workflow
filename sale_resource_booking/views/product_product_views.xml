<data>
    <record id="product_product_form_view" model="ir.ui.view">
        <field name="name">Display resource booking info in variant form</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view" />
        <field name="arch" type="xml">
            <group name="sale" position="inside">
                <group
                    name="booking"
                    string="Resource Bookings"
                    groups="resource_booking.group_user"
                >
                    <field name="resource_booking_type_id" />
                    <field
                        name="resource_booking_type_combination_rel_id"
                        invisible="not resource_booking_type_id"
                    />
                </group>
            </group>
        </field>
    </record>

    <record id="product_product_tree_view" model="ir.ui.view">
        <field name="name">product.product.list.sale.resource.booking</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view" />
        <field name="arch" type="xml">
            <field name="uom_id" position="after">
                <field
                    name="resource_booking_type_id"
                    optional="show"
                    groups="resource_booking.group_user"
                />
                <field
                    name="resource_booking_type_combination_rel_id"
                    optional="hide"
                    groups="resource_booking.group_user"
                />
            </field>
        </field>
    </record>

    <record id="product_variant_easy_edit_view" model="ir.ui.view">
        <field name="name">product.product.view.form.easy.resource.booking</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_variant_easy_edit_view" />
        <field name="arch" type="xml">
            <group name="sales" position="after">
                <group
                    name="booking"
                    string="Resource Bookings"
                    groups="resource_booking.group_user"
                >
                    <field name="resource_booking_type_id" />
                    <field
                        name="resource_booking_type_combination_rel_id"
                        invisible="not resource_booking_type_id"
                    />
                </group>
            </group>
        </field>
    </record>
</data>
