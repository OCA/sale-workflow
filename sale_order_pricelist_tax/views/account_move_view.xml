<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="account_move_view_form" model="ir.ui.view">
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <header position="after">
                <div
                    class="alert alert-danger alert-dismissable"
                    role="alert"
                    style="margin-bottom:0px;"
                    invisible="price_tax_state != 'exception'"
                >Invoice lines must have the same type of tax:
                     <br /> - Either price include tax
                    <br /> - Either price exclude tax
                </div>
            </header>
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="price_tax_state" invisible="1" />
            </xpath>
            <xpath expr="//list/field[@name='price_subtotal']" position="attributes">
                <attribute
                    name="column_invisible"
                >parent.price_tax_state == 'include'</attribute>
            </xpath>
            <xpath expr="//list/field[@name='price_total']" position="attributes">
                <attribute
                    name="column_invisible"
                >parent.price_tax_state != 'include'</attribute>
            </xpath>
        </field>
    </record>
</odoo>
