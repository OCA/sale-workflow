<odoo>
    <record id="product_attribute_list_inherit_lead_time" model="ir.ui.view">
        <field name="name">product.attribute.list.inherit.lead.time</field>
        <field name="model">product.attribute</field>
        <field name="inherit_id" ref="product.product_attribute_view_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='value_ids']/list/field[@name='default_extra_price']"
                position="after"
            >
                <field name="lead_time" />
            </xpath>
        </field>
    </record>
</odoo>
