#. module: sale_purchase_stock_auto_cancel
#: model_terms:ir.ui.view,arch_db:sale_purchase_stock_auto_cancel.res_config_settings_view_form
msgid ""
"Automatically cancel purchase orders created from sales orders using MTO or "
"Dropship rules when the sales order is canceled."
msgstr ""
"Cancelar automáticamente los pedidos de compra creados a partir de pedidos "
"de venta mediante reglas MTO o Dropship cuando se cancele el pedido de "
"venta."

