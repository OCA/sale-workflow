<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record
        id="res_config_settings_view_form_inherit_sale_order_add_byproduct"
        model="ir.ui.view"
    >
        <field
            name="name"
        >res.config.settings.view.form.inherit.sale.order.add.byproduct</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="40" />
        <field name="inherit_id" ref="mrp.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='mrp']" position="inside">
                <block title="By-product Settings" name="byproduct_configuration_block">
                    <setting>
                        <field name="byproduct_note_template" />
                        <label
                            for="byproduct_note_template"
                            string="By-product Note Template"
                        />
                        <div class="text-muted">
                            Template for the note on sale order lines created for by-products.
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
