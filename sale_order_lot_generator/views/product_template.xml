<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="product_template_form_view" model="ir.ui.view">
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock.product_template_form_view_stock" />
        <field name="arch" type="xml">
            <field name="store_by" position="after">
                <field
                    name="auto_generate_prodlot"
                    invisible="store_by not in ('lot', 'serial')"
                    groups="stock.group_production_lot"
                />
            </field>
        </field>
    </record>
</odoo>
