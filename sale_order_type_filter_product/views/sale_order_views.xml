<odoo>
    <record id="sale_order_form_view_filter_product" model="ir.ui.view">
        <field name="name">sale.order.form.filter.product</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <field name="order_line" position="before">
                <field name="type_allowed_product_ids" invisible="1" />
            </field>

            <xpath
                expr="//field[@name='order_line']/form//field[@name='product_id']"
                position="attributes"
            >
                <attribute name="domain">
                    [
                        ('sale_ok', '=', True),
                        ('type', '!=', 'combo'),
                        ('id', 'in', parent.type_allowed_product_ids)
                    ]
                </attribute>
            </xpath>

            <xpath
                expr="//field[@name='order_line']/list//field[@name='product_id']"
                position="attributes"
            >
                <attribute name="domain">
                    [
                        ('sale_ok', '=', True),
                        ('id', 'in', parent.type_allowed_product_ids)
                    ]
                </attribute>
            </xpath>
        </field>
    </record>
</odoo>
