<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record
        id="res_config_settings_view_form_inherit_portal_sale_confirm_require_login"
        model="ir.ui.view"
    >
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//block[@name='quotation_order_setting_container']"
                position="inside"
            >
                <setting
                    id="portal_sale_access_login_required"
                    help="If enabled, public users must log in before they can access quotations or orders from portal links."
                >
                    <field name="portal_sale_access_login_required" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
