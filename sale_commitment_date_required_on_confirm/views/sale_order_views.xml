<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.form.commitment.date.header</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <!-- Applied last, so the move still works when another module that
             alters this block is installed. -->
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath
                expr="//group[@name='order_details']/field[@name='show_update_pricelist']"
                position="before"
            >
                <xpath
                    expr="//group[@name='sale_shipping']/label[@for='commitment_date']"
                    position="move"
                />
                <xpath
                    expr="//group[@name='sale_shipping']/div[hasclass('o_row')]"
                    position="move"
                />
            </xpath>
        </field>
    </record>
</odoo>
