<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name"
        >res.config.settings.form.inherit.sale.commitment.date.required</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//block[@name='quotation_order_setting_container']/setting[@id='no_edit_order']"
                position="after"
            >
                <setting
                    id="sale_commitment_date_required"
                    help="Require the delivery date to confirm a sales order"
                >
                    <field name="sale_commitment_date_required" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
