<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="res_config_settings_view_form_delivery_request" model="ir.ui.view">
        <field name="name">res.config.settings.form - sale_delivery_request</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='sale_management']" position="inside">
                <block title="Delivery Requests" name="delivery_request_settings">
                    <setting
                        string="Expiration Days"
                        help="Number of calendar days after the response date before a confirmed delivery request expires."
                    >
                        <div class="content-group">
                            <div class="row mt16">
                                <label
                                    for="delivery_request_expiration_days"
                                    class="col-lg-3 o_light_label"
                                />
                                <field name="delivery_request_expiration_days" />
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
