<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="module_category_delivery_request" model="ir.module.category">
        <field name="name">Delivery Requests</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_sale_delivery_request_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_delivery_request" />
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
        <field name="users" eval="[(4, ref('base.user_admin'))]" />
    </record>

</odoo>
