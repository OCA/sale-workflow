<templates xml:space="preserve">
    <t t-inherit="sale.Product" t-inherit-mode="extension">
        <div name="o_sale_product_configurator_name" position="after">
            <t t-if="this.props.default_product_packaging_level_name">
                <div
                    class="mb-2 mb-lg-4 text-break"
                    name="o_sale_product_configurator_default_packaging"
                >
                    <span class="fa fa-cube" />
                    <span> Packaging: </span>
                    <span t-out="this.props.default_product_packaging_level_name" />
                </div>
            </t>
        </div>
    </t>

</templates>
