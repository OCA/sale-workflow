<odoo>
    <record model="ir.ui.view" id="sale_order_view_form">
        <field name="name">sale.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <sheet position="before">
                <div
                    class="alert alert-danger mb-0"
                    role="alert"
                    invisible="not warehouse_rule_need_change"
                >
                    <field name="warehouse_rule_need_change" />
                </div>
            </sheet>

            <xpath
                expr="//field[@name='order_line']/list/field[@name='warehouse_id']"
                position="attributes"
            >
                <attribute
                    name="column_invisible"
                >not parent.show_sale_line_warehouse_column</attribute>
            </xpath>
        </field>
    </record>
</odoo>
