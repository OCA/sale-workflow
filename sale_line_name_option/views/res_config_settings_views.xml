<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='order_warnings']" position="after">
                <setting
                    id="no_product_code_in_sale_line_name"
                    string="No Product Code in Sale Line Name"
                    help="If enabled, product codes will be omitted from sale order line names."
                >
                    <field name="no_product_code_in_sale_line_name" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
