<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <app name="sale_management" position="inside">
                <block
                    title="Sale Planner Calendar"
                    name="sale_planner_calendar_container"
                >
                    <setting
                        id="susbscriptions_backward_days"
                        help="Backward days to search documents to update subscriptions"
                    >
                        <field name="susbscriptions_backward_days" />
                    </setting>
                    <setting
                        id="sale_planner_forward_months"
                        help="Forward months to create calendar events"
                    >
                        <field name="sale_planner_forward_months" />
                    </setting>
                    <setting
                        id="sale_planner_mail_to_attendees"
                        help="Send invitations to attendees when a planner event is created"
                    >
                        <field name="sale_planner_mail_to_attendees" />
                    </setting>
                    <setting
                        id="sale_planner_order_cut_hour"
                        help="Time of the next day until which orders of the current day are assigned"
                    >
                        <field name="sale_planner_order_cut_hour" />
                    </setting>
                    <setting
                        id="sale_planner_calendar_max_duration"
                        help="Show a warning message when duration is more than this time.
                                Set 00:00 to disable warning."
                    >
                        <field name="sale_planner_calendar_max_duration" />
                    </setting>
                    <setting
                        id="sale_planner_done_on_sale_confirm"
                        help="Set event as done when related sale order is confirmed."
                    >
                        <field name="sale_planner_done_on_sale_confirm" />
                    </setting>
                </block>
            </app>
        </field>
    </record>
</odoo>
