<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="product_template_quantity_restriction_view_form" model="ir.ui.view">
        <field name="name">product.template.restriction.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <group name="description" position="before">
                    <group
                    string="Sale Quantity Restriction"
                    name="sale_quantity_restriction"
                >
                        <field name="parent_quantity_restriction_id" />
                        <field name="manual_quantity_restriction_id" />
                    </group>
            </group>
        </field>
    </record>

    <record id="product_category_quantity_restriction_view_form" model="ir.ui.view">
        <field name="name">product.category.restriction.form</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view" />
        <field name="arch" type="xml">
            <group name="first" position="inside">
                <field name="parent_quantity_restriction_id" />
                <field name="manual_quantity_restriction_id" />
            </group>
        </field>
    </record>

</odoo>
