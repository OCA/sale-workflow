<odoo>
    <record id="sale_order_view_form" model="ir.ui.view">
        <field name="model">sale.order</field>
        <field
            name="inherit_id"
            ref="sale_stock.view_order_form_inherit_sale_stock_qty"
        />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='order_line']/form//widget[@name='qty_at_date_widget']"
                position="before"
            >
                <widget name="qty_per_warehouse_widget" />
            </xpath>
            <xpath
                expr="//field[@name='order_line']/list/widget[@name='qty_at_date_widget']"
                position="before"
            >
                <widget name="qty_per_warehouse_widget" width="20px" />
            </xpath>
        </field>
    </record>
</odoo>
