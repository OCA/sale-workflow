<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.form.inherit.sol.stock.field</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='proforma_configuration']" position="after">
                <setting
                    id="stock_field_on_sol"
                    help="Stock quantity field displayed per warehouse on sale order lines"
                >
                    <field name="stock_field_on_sol" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
