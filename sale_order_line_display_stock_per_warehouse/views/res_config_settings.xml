<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.form.inherit.sol.stock.field</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@id='proforma_configuration']" position="after">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_right_pane">
                            <label for="stock_field_on_sol" />
                            <div class="text-muted">
                                Stock quantity field displayed per warehouse on sale order lines
                            </div>
                            <div class="content-group">
                                <field name="stock_field_on_sol" />
                            </div>
                        </div>
                    </div>
            </xpath>
        </field>
    </record>
</odoo>
