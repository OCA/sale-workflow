<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_order_form_inherit_smartbutton" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.smartbutton</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_order_lines"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-list-ul"
                >
                    <field
                        name="order_line_count"
                        widget="statinfo"
                        string="Order Lines"
                    />
                </button>
            </xpath>
        </field>
    </record>
</odoo>
