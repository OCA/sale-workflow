<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.form - sale_stock_delivery_address_text</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='sale_shipping']" position="inside">
                <field
                    name="delivery_address_text"
                    placeholder="e.g. Morelos St. 123, Downtown, between X and Y St., blue gate..."
                />
            </xpath>
        </field>
    </record>
</odoo>
