<odoo>
    <record id="stock_package_view_form" model="ir.ui.view">
        <field name="name">stock.package.form.inherit</field>
        <field name="model">stock.package</field>
        <field name="inherit_id" ref="stock.stock_package_view_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//form/sheet/group/group/field[@name='location_id']"
                position="after"
            >
                <field name="customer_ref" />
            </xpath>
        </field>
    </record>
</odoo>
