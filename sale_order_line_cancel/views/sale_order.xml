<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="sale_order_form_view" model="ir.ui.view">
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='order_line']/form/group/group/div[field[@name='qty_delivered']]"
                position="after"
            >
                <field name="can_cancel_remaining_qty" invisible="1" />
                <button
                    title="Cancel remaining qty"
                    name="%(action_sale_order_line_cancel)d"
                    type="action"
                    icon="fa-ban"
                    colspan="2"
                    invisible="not can_cancel_remaining_qty"
                />
            </xpath>
            <xpath
                expr="//field[@name='order_line']/list/field[@name='qty_delivered']"
                position="after"
            >
                <field name="can_cancel_remaining_qty" column_invisible="1" />
                <button
                    title="Cancel remaining qty"
                    name="%(action_sale_order_line_cancel)d"
                    type="action"
                    icon="fa-ban"
                    invisible="not can_cancel_remaining_qty"
                />
            </xpath>
            <xpath
                expr="//field[@name='order_line']/list//field[@name='qty_delivered']"
                position="after"
            >
                <field name="product_qty_canceled" string="Canceled" optional="hide" />
                <field
                    name="product_qty_remains_to_deliver"
                    string="To Deliver"
                    optional="hide"
                />
            </xpath>
        </field>
    </record>
</odoo>
