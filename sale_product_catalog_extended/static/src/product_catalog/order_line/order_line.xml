<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-inherit="product.ProductCatalogOrderLine" t-inherit-mode="extension">
        <!-- For per-line cards portal to the line-specific div; for regular cards
             keep the product-level portal target. -->
        <xpath expr="//t[@t-portal]" position="attributes">
            <attribute
                name="t-portal"
            >env.lineId ? `#line-${env.lineId}-price` : `#product-${props.productId}-price`</attribute>
        </xpath>
        <!-- Wrap New line + Edit as a connected button group above Remove -->
        <xpath
            expr="//div[hasclass('o_product_catalog_buttons')]/button[@t-on-click.stop='() => this.env.addProduct()']"
            position="before"
        >
            <div
                t-if="isInOrder() &amp;&amp; displayEdit()"
                class="btn-group-vertical w-100 mb-1"
            >
                <button
                    t-on-click.stop="() => this.env.addNewOrderLine()"
                    class="btn btn-light border"
                >
                    <i class="fa fa-plus" />
                    New line
                </button>
                <button
                    t-on-click.stop="() => this.env.openOrderLine()"
                    class="btn btn-light border"
                >
                    <i class="fa fa-pencil-square-o" />
                    Edit
                </button>
            </div>
        </xpath>
        <!-- Make the Remove button wrapper and button full-width to match -->
        <xpath expr="//div[hasclass('o_tooltip_div_remove')]" position="attributes">
            <attribute name="class">o_tooltip_div_remove w-100</attribute>
        </xpath>
        <xpath
            expr="//div[hasclass('o_tooltip_div_remove')]/button[@t-on-click.stop='this.env.removeProduct']"
            position="attributes"
        >
            <attribute name="class">btn btn-light border w-100</attribute>
        </xpath>
    </t>
</templates>
