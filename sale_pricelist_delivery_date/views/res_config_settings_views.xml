<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='order_warnings']" position="after">
                <setting
                    id="use_delivery_date_price"
                    string="Use Delivery Date for Price Computation"
                    help="If enabled, the unit price of each sale order line will be calculated from the pricelist using the delivery date."
                >
                    <field name="use_delivery_date_price" />
                </setting>
                <setting
                    id="is_delivery_date_required"
                    string="Delivery Date Required"
                    help="If enabled, the Delivery Date field on the sales order will be required."
                >
                    <field name="is_delivery_date_required" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
