<odoo>
    <record id="view_sales_order_filter" model="ir.ui.view">
        <field name="name">commercial.partner.sale.order.search</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter" />
        <field name="arch" type="xml">
            <filter name="customer" position="before">
                <filter
                    name="commercial_partner_groupby"
                    string="Customer Entity"
                    context="{'group_by': 'commercial_partner_id'}"
                />
            </filter>
        </field>
    </record>
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_invoice_id']" position="before">
                <field name="commercial_partner_id" invisible="1" />
                <field name="commercial_partner_invoice_id" invisible="1" />
                <field name="partner_invoice_domain" invisible="1" />
                <field name="partner_shipping_domain" invisible="1" />
            </xpath>
            <xpath expr="//field[@name='partner_invoice_id']" position="attributes">
                <attribute name="domain">partner_invoice_domain</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_shipping_id']" position="attributes">
                <attribute name="domain">partner_shipping_domain</attribute>
            </xpath>
        </field>
    </record>
</odoo>
