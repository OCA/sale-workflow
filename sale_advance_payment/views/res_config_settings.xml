<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name"
        >res.config.settings.view.form.inherit.sale.advance.payment</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//app[@name='sale_management']/block[@name='catalog_setting_container']"
                position="after"
            >
                <block
                    title="Advance Payments"
                    name="advance_payment_setting_container"
                >
                    <setting
                        id="advance_overpayment_setting"
                        help="Allow advance payments that exceed the order amount. Useful for e-commerce integrations with tax calculation differences."
                        string="Allow Advance Overpayments"
                    >
                        <field name="allow_advance_overpayment" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
