<odoo>
    <record id="sale_order_form_view" model="ir.ui.view">
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='order_line']//list//field[@name='product_uom_qty']"
                position="after"
            >
                <field name="display_qty_by_warehouse_widget" column_invisible="1" />
                <field name="qty_by_warehouse_widget_data" column_invisible="1" />
                <widget name="qty_by_warehouse_widget" width="20px" />
            </xpath>
        </field>
    </record>
</odoo>
