<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form_sale" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='online_signature']" position="after">
                <setting
                    id="sale_auto_remove_zero_quantity_lines"
                    company_dependent="1"
                    help="Auto remove sale order lines with zero quantity upon confirmation."
                >
                    <field name="sale_auto_remove_zero_quantity_lines" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
