<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">start.end.dates.view_order_form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='order_line']/form//field[@name='product_id']"
                position="after"
            >
                <field
                    name="start_date"
                    invisible="not must_have_dates"
                    required="must_have_dates"
                />
                <field
                    name="end_date"
                    invisible="not must_have_dates"
                    required="must_have_dates"
                />
                <field
                    name="number_of_days"
                    invisible="not must_have_dates"
                    required="must_have_dates"
                />
                <field name="must_have_dates" column_invisible="True" />
            </xpath>
            <xpath
                expr="//field[@name='order_line']/list/field[@name='name']"
                position="after"
            >
                <field name="start_date" required="must_have_dates" optional="show" />
                <field name="end_date" required="must_have_dates" optional="show" />
                <field name="number_of_days" optional="hide" />
                <field name="must_have_dates" column_invisible="True" />
            </xpath>
            <field name="payment_term_id" position="after">
                <field name="default_start_date" />
                <field name="default_end_date" />
            </field>
        </field>
    </record>
</odoo>
