<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Extend product template form to show project_template_id for milestone_project -->
    <record
        id="product_template_form_view_inherit_milestone_project"
        model="ir.ui.view"
    >
        <field name="name">product.template.form.inherit.milestone.project</field>
        <field name="model">product.template</field>
        <field
            name="inherit_id"
            ref="sale_project.product_template_form_view_invoice_policy_inherit_sale_project"
        />
        <field name="arch" type="xml">
            <field name="project_template_id" position="attributes">
                <attribute
                    name="attrs"
                >{'invisible':[('service_tracking','not in',['task_in_project', 'project_only', 'milestone_project'])]}</attribute>
            </field>
        </field>
    </record>
</odoo>
