"Orders that are fully invoiced, without draft invoices, and whose invoices "
"are all paid"
msgstr ""
"Pedidos completamente facturados, sin facturas en borrador, y cuyas facturas"
" están todas pagadas"

#. module: sale_order_payment_state
#: model_terms:ir.ui.view,arch_db:sale_order_payment_state.view_sales_order_filter
msgid "Orders with posted invoices that still have an open amount"
msgstr "Pedidos con facturas publicadas que aún tienen un importe pendiente"

