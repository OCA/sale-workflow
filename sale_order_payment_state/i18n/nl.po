#. module: sale_order_payment_state
#: model:ir.model.fields,help:sale_order_payment_state.field_sale_order__invoice_amount_residual
msgid ""
"Open amount of the posted customer invoices minus the open amount of the "
"posted credit notes of this order."
msgstr ""
"Openstaand bedrag van de geboekte klantfacturen min het openstaande bedrag "
"van de geboekte creditnota's van deze order."

#. module: sale_order_payment_state
#: model_terms:ir.ui.view,arch_db:sale_order_payment_state.view_sales_order_filter
