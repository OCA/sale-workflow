<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_sale_invoice_plan_form_allocation" model="ir.ui.view">
        <field name="name">sale.invoice.plan.form.allocation</field>
        <field name="model">sale.invoice.plan</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Installment">
                            <field name="installment" readonly="1" />
                            <field name="plan_date" readonly="1" />
                        </group>
                        <group string="Target">
                            <field
                                name="amount"
                                string="Target Untaxed Amount"
                                readonly="1"
                            />
                            <field name="allocated_amount" readonly="1" />
                            <field name="amount_to_allocate" readonly="1" />
                            <field name="allocation_method" invisible="1" />
                            <field name="currency_id" invisible="1" />
                            <field name="no_edit" invisible="1" />
                        </group>
                    </group>
                    <separator string="Sales Order Line Allocation" />
                    <button
                        name="action_prepare_allocations"
                        string="Refresh Sales Order Lines"
                        type="object"
                        class="btn-secondary"
                        icon="fa-refresh"
                        invisible="no_edit or allocation_method != 'manual'"
                    />
                    <button
                        name="action_prepare_allocations"
                        string="Rebuild Sequential Allocations"
                        type="object"
                        class="btn-secondary"
                        icon="fa-refresh"
                        confirm="Rebuild all open sequential allocations from the current sales order lines?"
                        invisible="no_edit or allocation_method != 'sequential'"
                    />
                    <field name="allocation_ids" readonly="no_edit">
                        <list
                            editable="bottom"
                            create="0"
                            delete="0"
                            decoration-muted="quantity == 0"
                        >
                            <field name="sale_id" column_invisible="True" />
                            <field name="sale_line_id" readonly="1" />
                            <field name="product_id" readonly="1" />
                            <field name="ordered_quantity" readonly="1" />
                            <field name="quantity" />
                            <field name="product_uom_id" readonly="1" />
                            <field name="currency_id" column_invisible="True" />
                            <field name="amount" readonly="1" sum="Allocated" />
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sale_invoice_plan_list_allocation" model="ir.ui.view">
        <field name="name">sale.invoice.plan.list.allocation</field>
        <field name="model">sale.invoice.plan</field>
        <field name="inherit_id" ref="sale_invoice_plan.view_sale_invoice_plan_list" />
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute
                    name="decoration-danger"
                >amount_to_allocate != 0 and allocation_method == 'manual' and not invoiced</attribute>
            </xpath>
            <field name="amount" position="after">
                <field name="allocation_method" column_invisible="True" />
                <field name="currency_id" column_invisible="True" />
                <field name="allocated_amount" optional="hide" />
                <field name="amount_to_allocate" optional="hide" />
                <button
                    name="action_open_allocation"
                    string="Allocate"
                    type="object"
                    icon="fa-list"
                    invisible="allocation_method not in ('manual', 'sequential') or invoice_type != 'installment'"
                />
            </field>
        </field>
    </record>

    <record id="view_sale_invoice_plan_allocation_grid_list" model="ir.ui.view">
        <field name="name">sale.invoice.plan.allocation.grid.list</field>
        <field name="model">sale.invoice.plan.allocation</field>
        <field name="arch" type="xml">
            <list
                editable="bottom"
                create="0"
                delete="0"
                expand="1"
                decoration-muted="quantity == 0"
            >
                <field name="installment" readonly="1" />
                <field name="plan_date" readonly="1" />
                <field name="sale_id" column_invisible="True" />
                <field name="sale_line_id" readonly="1" />
                <field name="product_id" readonly="1" optional="hide" />
                <field name="ordered_quantity" readonly="1" />
                <field name="quantity" readonly="no_edit" />
                <field name="product_uom_id" readonly="1" />
                <field name="currency_id" column_invisible="True" />
                <field name="amount" readonly="1" sum="Allocated" />
                <field name="no_edit" column_invisible="True" />
            </list>
        </field>
    </record>
</odoo>
