<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='pricelist_configuration']" position="after">
                <setting
                    id="partner_pricelist_setting"
                    help="When enabled. You can only select a pricelist that is allowed for the customer."
                >
                    <field name="use_partner_pricelist" />
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
