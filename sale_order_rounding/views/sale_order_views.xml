<odoo>
    <record id="sale_order_view_form_inherit_rounding" model="ir.ui.view">
        <field name="name">sale.order.view.form.inherit.rounding</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <div name="so_button_below_order_lines" position="inside">
                <button
                    name="action_apply_round_up"
                    type="object"
                    string="Round Up"
                    class="btn-secondary"
                    invisible="not order_line or state in ['cancel', 'sale']"
                />
            </div>
        </field>
    </record>
</odoo>
