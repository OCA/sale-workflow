<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name"
        >res.config.settings.view.form.sale.order.show.currency.rate</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//block[@name='quotation_order_setting_container']"
                position="after"
            >
                <block
                    title="Exchange Rate"
                    name="currency_rate_report_setting_container"
                >
                    <setting string="Report Reference Currency">
                        <field name="sale_order_currency_report_id" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
