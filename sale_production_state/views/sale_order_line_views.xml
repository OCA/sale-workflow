<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="sale_order_line_list" model="ir.ui.view">
        <field name="name">sale.order.line.list.inherit</field>
        <field name="inherit_id" ref="sale.view_order_line_tree" />
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='price_subtotal']" position="before">
                <field name="production_state" optional="hide" />
            </xpath>
        </field>
    </record>

    <record id="sale_order_line_form_readonly" model="ir.ui.view">
        <field name="name">sale.order.line.form.readonly.inherit</field>
        <field name="inherit_id" ref="sale.sale_order_line_view_form_readonly" />
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='qty_invoiced']" position="after">
                <field name="production_state" />
            </xpath>
        </field>
    </record>
</odoo>
