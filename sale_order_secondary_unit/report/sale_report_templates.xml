<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
        id="report_saleorder_document"
        inherit_id="sale.report_saleorder_document"
    >
        <th name="th_quantity" position="before">
            <th
                name="th_secondary_unit"
                class="text-end"
                t-if="not doc.company_id.hide_secondary_uom_column(doc)"
                groups="uom.group_uom"
            >
                <strong>Second Qty</strong>
            </th>
        </th>
        <xpath expr="//td[@name='td_quantity']" position="before">
            <td
                id="secondary_unit"
                class="text-end"
                t-if="not doc.company_id.hide_secondary_uom_column(doc)"
                groups="uom.group_uom"
            >
                <span t-field="line.secondary_uom_qty" />
                <span t-field="line.secondary_uom_id" />
            </td>
        </xpath>
        <xpath expr="//span[@t-field='line.product_uom_qty']" position="attributes">
            <attribute
                name="t-if"
            >line.get_secondary_uom_display_mode() != 'secondary'</attribute>
        </xpath>
        <xpath expr="//span[@t-field='line.product_uom']" position="attributes">
            <attribute
                name="t-if"
            >line.get_secondary_uom_display_mode() != 'secondary'</attribute>
        </xpath>
        <xpath expr="//span[@t-field='line.product_uom']" position="after">
            <t t-if="line.get_secondary_uom_display_mode() == 'secondary'">
                <span t-field="line.secondary_uom_qty" />
                <span t-field="line.secondary_uom_id" groups="uom.group_uom" />
            </t>
        </xpath>
        <xpath expr="//span[@t-field='line.product_uom_qty']/.." position="inside">
            <t t-if="line.get_secondary_uom_display_mode() == 'both'">
                <br />
                <span id="secondary_uom_qty" class="text-muted">
                    (<span t-field="line.secondary_uom_qty" />
                    <span t-field="line.secondary_uom_id" groups="uom.group_uom" />)
                </span>
            </t>
        </xpath>
        <xpath expr="//span[@t-field='line.price_unit']" position="attributes">
            <attribute
                name="t-if"
            >line.get_secondary_uom_display_mode() != 'secondary'</attribute>
        </xpath>
        <xpath expr="//span[@t-field='line.price_unit']" position="after">
            <t t-call="sale_order_secondary_unit.sale_uom_price" />
        </xpath>
    </template>
</odoo>
