<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t
        t-name="sale_order_secondary_unit.ProductCatalogOrderLineSecondaryUom"
        t-inherit="product.ProductCatalogOrderLine"
        t-inherit-mode="extension"
    >
        <xpath expr="//div[hasclass('o_product_catalog_quantity')]" position="after">
            <span
                t-if="props.uomToAdd"
                class="o_product_catalog_secondary_uom align-self-center mx-1 text-muted text-truncate"
                t-att-title="props.uomToAdd"
                t-out="props.uomToAdd"
            />
        </xpath>
    </t>
</templates>
