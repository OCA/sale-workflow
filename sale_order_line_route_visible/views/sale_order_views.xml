<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_order_form_route_visible" model="ir.ui.view">
        <field name="name">sale.order.form.route.visible</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_stock.view_order_form_inherit_sale_stock" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='order_line']//list//field[@name='route_ids']"
                position="attributes"
            >
                <attribute name="optional">show</attribute>
            </xpath>
        </field>
    </record>
</odoo>
