<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='order_line']//column[@name='product_and_description']/field[@name='product_id']"
                position="after"
            >
                <field
                    name="hide_product_name"
                    widget="boolean_toggle"
                    class="o_hide_product_name_toggle"
                    invisible="not name or display_type"
                    readonly="parent.state in ('sale', 'cancel')"
                />
            </xpath>
        </field>
    </record>
</odoo>
