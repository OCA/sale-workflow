<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <sheet position="before">
                <div
                    class="alert alert-info alert-dismissable"
                    role="alert"
                    style="margin-bottom:0px;"
                    invisible="not multiple_source_warehouses"
                >
                    <field name="multiple_source_warehouses" />
                </div>
            </sheet>

            <xpath
                expr="//field[@name='order_line']/list/field[@name='warehouse_id']"
                position="attributes"
            >
                <attribute name="column_invisible">False</attribute>
                <attribute name="readonly">state not in ['draft', 'sent']</attribute>
            </xpath>
        </field>
    </record>
    <record id="view_order_form_form" model="ir.ui.view">
        <field name="name">sale.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_stock.view_order_form_inherit_sale_stock" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='order_line']/form//field[@name='route_id']"
                position="before"
            >
                <field name="warehouse_id" readonly="state not in ['draft', 'sent']" />
            </xpath>
        </field>
    </record>
</odoo>
