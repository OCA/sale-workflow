<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name"
        >res.config.settings.view.form.inherit.sale_order_merge</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='no_edit_order']" position="after">
                <setting
                    id="to_merge_order_confirm"
                    help="Allow merging confirmed orders"
                >
                    <field name="merge_order_confirm" />
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
