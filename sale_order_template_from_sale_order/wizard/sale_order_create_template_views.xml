<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="sale_order_create_template_view_form" model="ir.ui.view">
        <field name="name">sale.order.create.template.form</field>
        <field name="model">sale.order.create.template</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="sale_order_id" invisible="1" />
                    <field name="name" />
                </group>
                <footer>
                    <button
                        name="action_create_template"
                        type="object"
                        string="Create"
                        class="btn-primary"
                    />
                    <button string="Cancel" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="sale_order_create_template_action" model="ir.actions.act_window">
        <field name="name">Template</field>
        <field name="res_model">sale.order.create.template</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
