<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name"
        >res.config.settings.view.form.inherit.sale.order.partner.restrict</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='order_warnings']" position="after">
                <setting
                    id="sale_order_partner_restrict"
                    string="Partner Restriction on Sale Orders"
                    help="Choose Partner Restrictions on Sale Orders"
                >
                    <field
                        name="sale_order_partner_restrict"
                        widget="radio"
                        required="True"
                    />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
