<odoo>
    <record id="view_sales_config" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <block name="quotation_order_setting_container" position="inside">
                <setting
                    id="sale_warehouse_rule"
                    string="Display Warehouse column in Sale Order Lines"
                >
                    <field name="show_sale_line_warehouse_column" />
                </setting>
            </block>
        </field>
    </record>
</odoo>
