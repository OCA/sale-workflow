<odoo>
    <record id="view_sales_config" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='group_auto_done_setting']/../.."
                position="after"
            >
                <div class="col-xs-12 col-md-6 o_setting_box">
                    <div class="o_setting_left_pane">
                        <field name="show_sale_line_warehouse_column" />
                    </div>
                    <div class="o_setting_right_pane">
                        <label
                            for="show_sale_line_warehouse_column"
                            string="Afficher la colonne entrepôt sur les lignes de commande"
                        />
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
