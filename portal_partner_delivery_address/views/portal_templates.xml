<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--
        Extend the sale order portal content to add:
        1. A shipping address management section (visible on draft/sent orders).
        2. A Bootstrap modal for selecting from available delivery addresses.
        3. A link to add a new delivery address directly from the quotation (DECISION 1).
        4. Clean layout suppressing duplicate shipping info in customer_info.

        Target: sale.sale_order_portal_content (matches OCA standards).
    -->
    <template
        id="sale_order_portal_content_shipping"
        name="Portal Delivery Address: Shipping Address Management"
        inherit_id="sale.sale_order_portal_content"
    >
        <!-- When can_change_shipping is active, suppress internal duplicate shipping address in customer_info -->
        <xpath expr="//span[@id='shipping_address']" position="attributes">
            <attribute
                name="t-if"
            >not can_change_shipping and sale_order.partner_shipping_id != sale_order.partner_invoice_id</attribute>
        </xpath>

        <!-- Ensure customer_info heading shows 'Invoicing Address' when shipping is separately managed -->
        <xpath expr="//div[@id='customer_info']/h5/t[1]" position="attributes">
            <attribute
                name="t-if"
            >not can_change_shipping and sale_order.partner_shipping_id == sale_order.partner_invoice_id</attribute>
        </xpath>

        <!--
            Append the shipping management block + modal after customer_info.
            This is only rendered when can_change_shipping and
            portal_delivery_addresses are provided by the controller.
        -->
        <xpath expr="//div[@id='customer_info']" position="after">
            <!-- ========================================================= -->
            <!-- Section: Delivery Address Selector (draft/sent only)       -->
            <!-- ========================================================= -->
            <t t-if="can_change_shipping">
                <div id="portal_shipping_address_section" class="col-12 col-lg-6 mb-4">
                    <h5 class="mb-1">
                        Delivery Address
                        <small t-if="portal_delivery_addresses">
                        <a
                            href="#"
                            class="small text-primary"
                            data-bs-toggle="modal"
                            data-bs-target="#o_portal_shipping_modal"
                            id="o_portal_change_shipping_btn"
                        >
                                <i class="fa fa-fw fa-pencil" />
                                Change
                            </a>
                    </small>
                    </h5>
                    <hr class="mt-1 mb-2" />
                    <div
                        t-field="sale_order.partner_shipping_id"
                        t-options='{ "widget": "contact", "fields": ["name", "address"]}'
                        id="o_portal_current_shipping_address"
                    />
                    <!-- Link to add a new delivery address (DECISION 1: includes order_id) -->
                    <a
                        t-attf-href="/my/address?address_type=delivery&amp;callback={{ sale_order.get_portal_url() }}&amp;order_id={{ sale_order.id }}"
                        class="btn btn-sm btn-outline-secondary mt-2"
                        id="o_portal_add_delivery_address_btn"
                    >
                        <i class="fa fa-plus me-1" />
                        Add a delivery address
                    </a>
                </div>

                <!-- ===================================================== -->
                <!-- Bootstrap Modal: Delivery Address Picker               -->
                <!-- ===================================================== -->
                <t t-if="portal_delivery_addresses">
                    <div
                        class="modal fade"
                        id="o_portal_shipping_modal"
                        tabindex="-1"
                        aria-labelledby="o_portal_shipping_modal_label"
                        aria-hidden="true"
                    >
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5
                                        class="modal-title"
                                        id="o_portal_shipping_modal_label"
                                    >
                                        Select Delivery Address
                                    </h5>
                                    <button
                                        type="button"
                                        class="btn-close"
                                        data-bs-dismiss="modal"
                                        aria-label="Close"
                                    />
                                </div>
                                <form
                                    t-attf-action="/my/orders/{{ sale_order.id }}/update_shipping_address"
                                    method="POST"
                                    id="o_portal_shipping_address_form"
                                >
                                    <!-- CSRF token (AC8) -->
                                    <input
                                        type="hidden"
                                        name="csrf_token"
                                        t-att-value="request.csrf_token()"
                                    />
                                    <div class="modal-body">
                                        <div
                                            class="list-group"
                                            id="o_portal_shipping_address_list"
                                        >
                                            <t
                                                t-foreach="portal_delivery_addresses"
                                                t-as="addr"
                                            >
                                                <label
                                                    t-attf-class="list-group-item list-group-item-action d-flex align-items-center gap-2 {{ 'active' if addr.id == sale_order.partner_shipping_id.id else '' }}"
                                                >
                                                    <input
                                                        type="radio"
                                                        name="shipping_partner_id"
                                                        t-att-value="addr.id"
                                                        t-att-checked="addr.id == sale_order.partner_shipping_id.id or None"
                                                        t-attf-id="o_shipping_addr_{{ addr.id }}"
                                                    />
                                                    <span>
                                                        <strong t-out="addr.name" />
                                                        <t t-if="addr.street">
                                                            , <t t-out="addr.street" />
                                                        </t>
                                                        <t t-if="addr.city">
                                                            , <t t-out="addr.city" />
                                                        </t>
                                                        <t t-if="addr.country_id">
                                                            , <t
                                                            t-out="addr.country_id.name"
                                                        />
                                                        </t>
                                                    </span>
                                                </label>
                                            </t>
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button
                                            type="button"
                                            class="btn btn-secondary"
                                            data-bs-dismiss="modal"
                                        >
                                            Cancel
                                        </button>
                                        <button
                                            type="submit"
                                            class="btn btn-primary"
                                            id="o_portal_shipping_address_submit"
                                        >
                                            Update Delivery Address
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </xpath>
    </template>
</odoo>
