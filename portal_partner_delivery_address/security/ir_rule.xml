<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!--
        Portal users may read delivery-type addresses that are children of
        their own commercial partner.

        Security Defence Layers:
        1. This ir.rule blocks ORM-level reads of other tenants' delivery addresses.
        2. The controller enforces _can_be_edited_by_current_customer() before writes.
        3. The model's action_update_portal_shipping_address re-checks ownership
           before any sudo() write, as required by OCA guidelines.
    -->
    <record id="rule_portal_delivery_address_read" model="ir.rule">
        <field
            name="name"
        >Portal: Read own commercial partner delivery addresses</field>
        <field name="model_id" ref="base.model_res_partner" />
        <field name="domain_force">
            [
                ('id', 'child_of', user.commercial_partner_id.id),
                ('type', '=', 'delivery'),
            ]
        </field>
        <field name="groups" eval="[Command.link(ref('base.group_portal'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>
</odoo>
